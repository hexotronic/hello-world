{
  "name": "florakarten",
  "version": "2.1.0",
  "private": true,
  "description": "Karteikarten-App mit Wiederholung in wachsenden Abständen, Zufallsfotos und Pflanzen-Extras",
  "scripts": {
    "start": "python3 -m http.server 8123 --directory www",
    "android:sync": "cap sync android",
    "android:build": "cap sync android && cd android && ./gradlew assembleDebug",
    "test:speech": "node tests/speech-eval.mjs",
    "test:facts": "node tests/facts-eval.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  },
  "type": "module"
}
