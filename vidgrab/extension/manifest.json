{
  "manifest_version": 2,
  "name": "VidGrab – Videos extern abspielen",
  "short_name": "VidGrab",
  "version": "1.4.0",
  "description": "Findet Video-Dateien und Streams (MP4, WebM, HLS/m3u8, DASH) auf Webseiten und öffnet sie direkt in VLC, MX Player, mpv & Co.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "webRequest",
    "<all_urls>",
    "tabs",
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "background": {
    "scripts": ["src/common/media.js", "src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/common/media.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "VidGrab – gefundene Videos",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vidgrab@hexotronic.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  }
}
