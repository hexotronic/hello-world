{
  "name": "vidgrab",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox-Add-on (Android & Desktop): Video-Dateien und Streams finden und in VLC & Co. abspielen",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest --filename vidgrab-{version}.xpi",
    "start:android": "web-ext run --source-dir extension -t firefox-android --firefox-apk org.mozilla.firefox",
    "icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "license": "MIT"
}
